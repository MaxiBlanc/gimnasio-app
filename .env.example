# Copiá este archivo como ".env" (cp .env.example .env) y ajustá lo que haga falta.
# .env NO se sube a git; este archivo de ejemplo sí.

NODE_ENV=development
PUERTO=3000
# Origen del front permitido por CORS.
ORIGEN_WEB=http://localhost:5173

# Base de datos de desarrollo (docker-compose). Prisma exige que se llame DATABASE_URL.
DATABASE_URL=postgresql://gimnasio:gimnasio@localhost:5433/gimnasio

# Clave para firmar los JWT (mínimo 32 caracteres). Generá una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=cambiame-por-una-clave-larga-y-aleatoria-de-32-o-mas
# Duración de los tokens (opcional)
MINUTOS_TOKEN_ACCESO=15
DIAS_TOKEN_REFRESCO=30
